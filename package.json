{
  "name": "oont",
  "version": "0.3.0-alpha.2",
  "type": "module",
  "description": "A factual context compiler that gives agents verified context or a typed refusal.",
  "main": "src/openontology.mjs",
  "exports": {
    ".": "./src/openontology.mjs",
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ontology",
    "mcp",
    "agents",
    "context",
    "verification",
    "retrieval"
  ],
  "bin": {
    "oont": "bin/oont.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin/oont.mjs",
    "scripts/oont-resolver.mjs",
    "src/assertion-envelope.mjs",
    "src/bm25-index.mjs",
    "src/canonical-object-backend.mjs",
    "src/canonical-content.mjs",
    "src/gcs-object-storage-backend.mjs",
    "src/object-ont-store.mjs",
    "src/object-storage-backend.mjs",
    "src/openontology.mjs",
    "src/s3-object-storage-backend.mjs",
    "src/source-native-artifact.mjs",
    "src/source-native-evidence-session.mjs",
    "src/source-native-field-resolution.mjs",
    "src/source-native-field-resolver.mjs",
    "src/source-native-identity-census.mjs",
    "src/source-native-object-map.mjs",
    "src/source-native-object-ont.mjs",
    "src/source-native-product-mcp.mjs",
    "src/source-native-product.mjs",
    "src/source-native-query-plan.mjs",
    "src/source-native-query-planner.mjs",
    "src/source-native-resolver-support.mjs",
    "docs/ARCHITECTURE.md",
    "docs/STORAGE.md",
    "examples/quickstart/",
    "CHANGELOG.md",
    "GLOSSARY.md"
  ],
  "dependencies": {},
  "scripts": {
    "test": "npm run check",
    "check": "npm run check:source-native-product && npm run check:canonical-object-backend",
    "check:source-native-product": "node scripts/test-product-surface-contract.mjs && node scripts/test-oont-cli-help.mjs && node --test scripts/test-source-native-product.mjs scripts/test-source-native-field-resolution.mjs && node scripts/test-source-native-object-map.mjs && node scripts/test-source-native-query-planner.mjs",
    "check:canonical-object-backend": "node --test scripts/test-canonical-content.mjs scripts/test-canonical-object-backend.mjs scripts/test-gcs-object-storage-backend.mjs",
    "check:package-import-closure": "node scripts/check-package-import-closure.mjs",
    "check:public-release": "node scripts/check-public-release.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "release:check": "npm run check && npm run check:package-import-closure && npm run check:public-release && npm run smoke:pack && git diff --check",
    "qualify:gcs-object-storage": "node scripts/qualify-gcs-object-storage.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doss-com/openontology.git"
  },
  "bugs": {
    "url": "https://github.com/Doss-com/openontology/issues"
  },
  "homepage": "https://github.com/Doss-com/openontology#readme",
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true
  }
}
