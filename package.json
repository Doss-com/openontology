{
  "name": "oont",
  "version": "0.3.0-alpha.3",
  "type": "module",
  "description": "A factual context compiler that gives agents verified context or a typed refusal.",
  "main": "./dist/src/openontology.mjs",
  "types": "./dist/src/openontology.d.mts",
  "exports": {
    ".": {
      "types": "./dist/src/openontology.d.mts",
      "import": "./dist/src/openontology.mjs"
    },
    "./kernel": {
      "types": "./dist/src/kernel.d.mts",
      "import": "./dist/src/kernel.mjs"
    },
    "./package.json": "./package.json"
  },
  "license": "Apache-2.0",
  "keywords": [
    "ontology",
    "mcp",
    "agents",
    "context",
    "verification",
    "retrieval"
  ],
  "bin": {
    "oont": "dist/bin/oont.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/",
    "docs/ARCHITECTURE.md",
    "docs/STORAGE.md",
    "examples/quickstart/",
    "CHANGELOG.md",
    "GLOSSARY.md"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "24.10.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "npm run check",
    "check": "npm run build && npm run check:source-native-product && npm run check:canonical-object-backend && npm run check:kernel",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "check:source-native-product": "node scripts/test-product-surface-contract.mjs && node scripts/test-oont-cli-help.mjs && node --test scripts/test-source-native-product.mjs scripts/test-source-native-field-resolution.mjs && node scripts/test-source-native-object-map.mjs && node scripts/test-source-native-query-planner.mjs",
    "check:canonical-object-backend": "node --test scripts/test-canonical-content.mjs scripts/test-canonical-object-backend.mjs scripts/test-gcs-object-storage-backend.mjs",
    "check:kernel": "node --test scripts/test-proof-sufficiency.mjs scripts/test-source-native-admitted-knowledge.mjs",
    "check:package-import-closure": "node scripts/check-package-import-closure.mjs",
    "check:public-release": "node scripts/check-public-release.mjs",
    "manifest:update": "node scripts/update-source-manifest.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "prepack": "npm run build",
    "release:check": "npm run check && npm run check:package-import-closure && npm run check:public-release && npm run smoke:pack && git diff --check",
    "qualify:gcs-object-storage": "npm run build && node scripts/qualify-gcs-object-storage.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Doss-com/openontology.git"
  },
  "bugs": {
    "url": "https://github.com/Doss-com/openontology/issues"
  },
  "homepage": "https://github.com/Doss-com/openontology#readme",
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "provenance": true
  }
}
